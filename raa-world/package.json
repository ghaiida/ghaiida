{
  "name": "raa-world",
  "version": "0.1.0",
  "private": true,
  "description": "راء وورلد — قالب الألعاب التعليمية الذكي القابل للتخصيص (منصة راء)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "node --disable-warning=ExperimentalWarning e2e/scenario.mjs",
    "codes:generate": "node --disable-warning=ExperimentalWarning --import tsx server/cli/generate-codes.ts",
    "admin:reset-password": "node --disable-warning=ExperimentalWarning --import tsx server/cli/reset-password.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "express": "^5.3.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^5.8.8",
    "write-excel-file": "^2.3.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.56",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
