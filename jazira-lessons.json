     "ex": "نقسم البسط والمقام في 2/4 على 2 فنحصل على 1/2.",
     "d": 1
    },
    {
     "q": "في الكسر 3/7، العدد 7 يُسمّى:",
     "a": [
      "المقام",
      "البسط",
      "الناتج",
      "العامل"
