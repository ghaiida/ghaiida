     "ex": "العدد السفلي في الكسر هو المقام، والعلوي هو البسط.",
     "d": 1
    },
    {
     "q": "ما ناتج 2/5 + 1/5 ؟",
     "a": [
      "3/5",
      "3/10",
      "2/25",
      "1/5"
     ],
     "ex": "المقامان متساويان، فنجمع البسطين ونُبقي المقام: 3/5.",
     "d": 1
    },
    {
     "q": "أيّ الكسور التالية هو الأكبر؟",
     "a": [
      "3/4",
      "2/3",
      "1/2",
      "5/8"
     ],
     "ex": "بالتحويل إلى عشري: 3/4 = 0.75 وهو أكبر من 0.67 و 0.5 و 0.625.",
     "d": 2
    },
    {
     "q": "الكسر 6/8 في أبسط صورة:",
     "a": [
      "3/4",
      "4/6",
      "2/3",
      "1/2"
     ],
     "ex": "نقسم البسط والمقام على 2: 6/8 = 3/4.",
     "d": 2
    },
    {
     "q": "ما ناتج 1/2 × 1/3 ؟",
     "a": [
      "1/6",
      "2/5",
      "1/5",
      "2/6"
     ],
     "ex": "نضرب البسط في البسط والمقام في المقام: 1/6.",
     "d": 2
    },
    {
     "q": "ما ناتج 3/4 − 1/4 ؟",
     "a": [
      "1/2",
      "1/4",
      "1",
      "3/4"
